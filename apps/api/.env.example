DATABASE_URL=postgresql://yield2pay:yield2pay@localhost:5433/yield2pay?schema=public
PRIVY_APP_ID=privy_app_id
PRIVY_APP_SECRET=privy_app_secret
# Antes do 1º boot com VAULT_PROVIDER=mock (padrão deste arquivo): rode
# `node apps/api/scripts/create-mock-devnet-mints.cjs` e cole os dois
# endereços que ele imprime em USDC_MINT e MOCK_VAULT_SHARE_MINT abaixo —
# sem isso o backend falha a validação de env no boot.
# Cluster lógico: devnet | mainnet-beta
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Moeda de depósito. Em devnet mock, é o mint de "Real de teste" (não USDC de
# verdade) — criar com: node apps/api/scripts/create-mock-devnet-mints.cjs
USDC_MINT=
# Qual VaultService usar: 'kamino' (reserve Kamino real — exige mainnet, a
# Kamino não tem oracle Scope em devnet) ou 'mock' (SPL tokens de teste, sem
# Kamino, para testar o fluxo completo em devnet). Ver
# docs/superpowers/plans/2026-09-04-mock-vault-devnet.md.
VAULT_PROVIDER=mock
# Só usado quando VAULT_PROVIDER=mock. Ver USDC_MINT acima — mesmo script cria os dois.
MOCK_VAULT_SHARE_MINT=
# Só usadas quando VAULT_PROVIDER=kamino (reserve Kamino real, exige mainnet
# ou staging Kamino — ver docs/DEPLOY.md). Obter em app.kamino.finance.
# KAMINO_MARKET_ADDRESS=
# KAMINO_RESERVE_ADDRESS=
# APY exibido pelo cofre mock (string de percentual; não há rendimento real).
MOCK_VAULT_APY_PERCENT=5.00
# Chave da tesouraria que paga a taxa (feePayer) e o aluguel das ATAs de USDC.
# Formato: array JSON de 64 bytes (o que `solana-keygen new` grava em id.json) ou base64.
FEE_SPONSOR_SECRET_KEY=[1,2,3,...,64]
PORT=3001
# Ambiente lógico: production | staging | development. Fora de production a
# resposta de erro carrega technicalDetails (stack, endpoint, requestId), que a
# tela de erro mostra no painel técnico. Precisa casar com NEXT_PUBLIC_APP_ENV.
APP_ENV=development
# CORS: comma-separated allowed web origins. Unset = reflect any origin (dev/MVP only).
# In production set to your deployed web domain, e.g. https://yield2pay.vercel.app
CORS_ORIGIN=http://localhost:3000
# Demo: injeta rendimento sintético (basis points) para a UI mostrar rendimento
# antes de o cofre render de verdade. 0 = desligado.
DEMO_YIELD_BPS=0
DEMO_RETURNS_CHANGE_PERCENT=3.2
